# Firebase AI Logic & App Check Configuration for VOX
# Duplicate this file to .env and fill in your Firebase Web App credentials.
# Do NOT commit your actual .env file or production keys.

# Firebase Web App Config (From Firebase Console > Project Settings > General > Web Apps)
VITE_FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Firebase App Check
# For production: reCAPTCHA Enterprise or reCAPTCHA v3 site key
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here

# For local development with App Check:
# Leave blank to auto-generate a debug token in Chrome console, or provide a static UUID
VITE_APPCHECK_DEBUG_TOKEN=
